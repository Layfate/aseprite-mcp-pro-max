{
  "name": "aseprite-mcp-pro-max",
  "version": "2.0.0",
  "description": "Unofficial MCP server for creating, editing, validating and exporting pixel art with a locally installed Aseprite.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration",
    "typecheck": "tsc -p . --noEmit",
    "doctor": "node dist/index.js doctor",
    "docs": "tsx scripts/gen-catalog.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "keywords": [
    "mcp",
    "aseprite",
    "pixel-art",
    "model-context-protocol"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "aseprite-mcp-pro-max": "dist/index.js"
  },
  "files": [
    "dist",
    "lua",
    "extension",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
